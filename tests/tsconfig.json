{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2023"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../src/contributionEvaluation/**/*.ts", "../api/**/*.ts"]
}
